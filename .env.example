# ==========================================
# Math Tutor Agent v1.0 環境變數設定範本
# 說明：將此檔複製為 .env 並依需求填入設定。
#       若全部留空或不建立 .env，系統將自動啟用 Deterministic Fallback 離線題庫模式。
# ==========================================

# [第一順位：地端 Ollama 推論服務（免 API Key、支援完全離線運作）]
# 若在 Podman/Docker 容器內執行並連線至本機 Ollama，請使用 host.containers.internal
OLLAMA_BASE_URL=http://host.containers.internal:11434
OLLAMA_MODEL=qwen3.5:4b

# [第二順位：雲端 LLM API 備援（擇一填寫即可）]
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=